# Flask secret key used to sign sessions — generate a long random string
SECRET_KEY=change-this-to-a-long-random-string

# Database connection string
# For local development (SQLite):
DATABASE_URL=sqlite:///academy.db
# For production (PostgreSQL), use something like:
# DATABASE_URL=postgresql://username:password@localhost:5432/siyar_academy

# Folder where uploaded files (thumbnails, videos, resources) are stored
UPLOAD_FOLDER=uploads

# Password used only by the `flask seed` command to create the first admin account
SEED_ADMIN_PASSWORD=change-me-before-running-seed
